# Required for live LLM agent evals (npm run test:agent)
OPENAI_API_KEY=sk-...

# Optional — reserved for Anthropic agent evals later
ANTHROPIC_API_KEY=

# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: MCP server port when running `npm run dev` / agent eval
# PORT=3000
